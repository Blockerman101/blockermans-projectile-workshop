single struct EnvironmentCollision
{
    public Number ID;
    //also serves as the data for a one time check
    public Number Time;
    public static EnvironmentCollision Construct(): {ID: null, Time: null};

    //Sink One-Time Queues to the end of the array
    public static void Queue(in Number ID, in Number Time) {
        _envCollisionList = _envCollisionList
            .Append(<EnvironmentCollision>{ID: ID, Time: Time})
            .Sort(v => v.Time)
            .Sort((v, idx) => idx + CountOf(v.Time) * 1000)
            ;
    }
    public static void ClearFromQueue(in Number ID) {_envCollisionList = _envCollisionList.Filter(v => v.ID != ID);}
}

