//A good design philosophy is to reference specific states, rather "Not" states
//projData[ID].ProjState == ProjState.Engaged //Good
//projData[ID].ProjState != ProjState.Inactive //Bad
//This helps future-proof
//The syntax wont be the exact same for users, but its still good info to have

enum ProjState
{
    NULL, //Debugging
    Active, //Projectile is processing passively/simply - run EC, update ProjState
    Inactive, //Projectile was spawned, then was destroyed
    Unsafe //The projectile ID is able to be overridden and thus have its current data destroyed

}



single struct ProjArgs
{
    //internal - do not set!
    private Number _ProjID;
        public Number _GetID() {return _ProjID;}
        public ref void _SetID(in Number ID) {_ProjID = ID;}

    //visual args
        public ProjFX ProjFX;
        public (Color|Team) Color;
        public String String;
        public Number VisualRadius;
        //WARNING: ProjArgs.VisibleTo = LocalPlayer() doesnt work!
        //Tip: Use ProjFX.None instead of VisibleTo = null
        public (Player|Player[]) VisibleTo;
        public (Player|Player[]) FriendlyTo;

    //functional args
        public Vector StartPosition;
        public Vector Direction;
        public Number Speed;
        //projectiles with 0 gravity must use Vector.Zero (not null), otherwise type-errors will break the proj
        public Vector Gravity;
        public Player[] Targets;
        public Number Radius;
        public Number Lifetime;
        //saves this projectiles data (prevents it from going Inactive -> Unsafe) for SaveDataTicks ticks (a tick is 0.016s)
        //Note that excessive save time (doing 9999 without thinking) is not recommended and even safeguarded against by the system (which caps it at ~600 ticks)
        public Number SaveDataTicks;

    //internal - do not set!
    private Number _TimeOfCall;
        public Number _GetTOC() {return _TimeOfCall;}
        public ref void _SetTOC(in Number time) {_TimeOfCall = time;} 
    public static ProjArgs Construct(): {
        ProjFX: ProjFX.None, 
        Color: null,
        StartPosition: Vector.Zero, 
        Direction: Vector.Zero, 
        Targets: null, 
        Radius: 0, 
        VisualRadius: 0,
        Speed: 0, 
        Lifetime: 0, 
        Gravity: Vector.Zero, 
        _ProjID: 0, 
        String: null,
        FriendlyTo: null,
        VisibleTo: null,
        SaveDataTicks: null,
        _TimeOfCall: 0
        };
    public static ProjArgs Default(in Player player=EventPlayer()): {
        ProjFX: ProjFX.Sphere, 
        Color: Color.Red,
        StartPosition: EyePosition(player), 
        Direction: player.FacingDirection(), 
        Targets: AllPlayers(OppositeTeamOf(TeamOf(player))), 
        Radius: 0,
        VisualRadius: 0.5,
        Speed: 20, 
        Lifetime: 3, 
        Gravity: Down() * 5, 
        _ProjID: null, 
        String: null,
        FriendlyTo: AllPlayers(TeamOf(player)),
        VisibleTo: AllPlayers(),
        SaveDataTicks: 10,
        _TimeOfCall: null
        };

    //Modifies your args with things that youll probably want, like gimbal locking fix
    public ProjArgs CommonPatches(in Player player=EventPlayer()) {
        return {
            //ensure proj starts somewhat out of player
            StartPosition: this.StartPosition + (0.5 * this.Direction * this.Radius), 
            
            //fix gimbal locking
            Direction: VerticalFacingAngleOf(player) <= -89.8 ? Up() : (VerticalFacingAngleOf(player) >= 89.8 ? Down() : this.Direction),
            ..this
        };
    }
}

//shared (relevant) args between CreateEffect, CreateProjectile, CreateProjectileEffect, and CreateInWorldText
//VisibleTo                 N - implemented
//ProjFX                    Y - implemented
//Color                     Y - implemented
//Position/StartPosition    Y - implemented
//Radius/Oversize/Scale     Y - implemented
//FriendlyTo                N - implemented
//Direction                 Y - implemented
//Player (proj owner)       N - owned through ID system, can be made player-relative
//AffectedTeam              N - 
//Speed                     Y - implemented
//Lifetime                  Y - implemented
//Gravity                   Y - implemented
//Header/String             Y - implemented




