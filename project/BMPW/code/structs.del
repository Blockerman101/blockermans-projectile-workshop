enum TypeOfDestruction
{
    NULL,
    Environment,
    Player,
    Timeout,
    JustInTime
}

single struct ProjDestructor
{
    public Number ID;
    public Number time; //The relative time to destroy this projectile
    public TypeOfDestruction TypeOfDestruction;
    //the length (in time) of the check subtracted by how much of the check was checked
    //equivalent to scopedInterval - timeToDestroy
    public Number TimeOfLastJITCheck;
    //Queue proj to be destroyed, the proj will be destroyed `time` seconds from when the method is called

    //public static void Queue(in Number ID, in Number time) {_projDestructorQueue = _projDestructorQueue.Append({ID: ID, time: UTILS_tte + time}).Sort(v => v.time);} //TTE() is automatically included, so the extra time is relative
    public static void Queue(in Number ID, in Number time, in TypeOfDestruction typeOfDestruction, in Number TimeOfLastJITCheck=null) {_projDestructorQueue = _projDestructorQueue.Append(<ProjDestructor>{ID: ID, time: TotalTimeElapsed() + time, TypeOfDestruction: typeOfDestruction, TimeOfLastJITCheck: TimeOfLastJITCheck}).Sort(v => v.time);}
    public static void QueueRaw(in Number ID, in Number time, in TypeOfDestruction typeOfDestruction, in Number TimeOfLastJITCheck=null) {_projDestructorQueue = _projDestructorQueue.Append(<ProjDestructor>{ID: ID, time: time, TypeOfDestruction: typeOfDestruction, TimeOfLastJITCheck: TimeOfLastJITCheck}).Sort(v => v.time);} //Queue without the automated TTE, letting you have full control over when, specifically, the proj is deleted
    public static void SortQueue() {_projDestructorQueue = _projDestructorQueue.Sort(v => v.time);}
    
    //Destroy proj ASAP
    public static void Destroy(in Number ID) {_projDestructorQueue = _projDestructorQueue.Append(<ProjDestructor>{ID: ID, time: null, TypeOfDestruction: TypeOfDestruction.NULL, TimeOfLastJITCheck: null}).Sort(v => v.time);}
    public static void ClearFromQueue(in Number ID) {_projDestructorQueue = _projDestructorQueue.Filter(v => v.ID != ID);}
}

struct ProjData
{
    //projectiles go from Null -> Active -> Inactive, with inactive indicating that they have been destroyed
    public ProjState ProjState;
    //The player hit by the projectile. Remains null if no player was hit
    public ProjHitData Hit;
    //declared at creation, immutable
    public InternalProjData Internal;
    //how long the projectile has been active for
    public Number Time(in InternalProjData overrideReadOnlyVar=Internal, in Number tte=TotalTimeElapsed()): (tte - overrideReadOnlyVar.TimeOfCreation);
        //p0 + t(v(gt/2)) or
        //p0s + tv * (gt^2 / 2)
    //The projectiles current position
    public Vector Position(in InternalProjData overrideReadOnlyVar=Internal, in Number tte=TotalTimeElapsed()): (overrideReadOnlyVar.InitPos + Time(overrideReadOnlyVar, tte) * (overrideReadOnlyVar.InitVelocity + overrideReadOnlyVar.Gravity * Time(overrideReadOnlyVar, tte) / 2));

    //The projectiles position at time, relative to its time
    //PositionAtTime(1) returns where the projectile will be in 1 second
    //PositionAtTime(-1) returns where the projectile was 1 second ago (even if the projectile hasnt existed for an entire second)
    public Vector PositionAtTime(in Number extraTime): this.Internal.InitPos + (Time() + extraTime) * (this.Internal.InitVelocity + this.Internal.Gravity * (Time() + extraTime) / 2);
    //public Vector PositionAtTime(in Number time): b0Time(time); //The above macro, "Position", assumes that "time" is 0. Inputting 0.5 for this will get you the position of the projectile 0.5s in the future

    //The projectiles position at a raw time
    //PositionAtRawTime(1) returns where the projectile is 1 second after creation, regardless of the projectiles current position or time
    public Vector PositionAtRawTime(in Number time): this.Internal.InitPos + time * (this.Internal.InitVelocity + this.Internal.Gravity * time / 2);

    //The projectiles current position
    public Vector Velocity(in InternalProjData overrideReadOnlyVar=Internal, in Number tte=TotalTimeElapsed()): overrideReadOnlyVar.InitVelocity + overrideReadOnlyVar.Gravity * Time(overrideReadOnlyVar, tte);
    public static ProjData Construct(): {
        ProjState: ProjState.NULL,
        Hit: ProjHitData.Construct(),  
        Internal: InternalProjData.Construct()
    };
    public static ProjData Get(in Number ID): projData[ID];
    //public static void AddArgs(in ProjArgs args) {projData.Map(v => projData[CurrentArrayIndex()].ProjArgs).ModAppend(args);}
}

single struct InternalProjData
{
    //first because its used in ProjData.Time(), which is called a ton
    public Number TimeOfCreation;
    public Vector InitPos;
    public Number Radius;
    public Player[] Targets;
    public Vector InitVelocity;
    //the vfx associated with the projectile, usually only the projfx but ive used it for stuff like beam effects for trajectories in testing
    public Number[] VFX;
    public Vector Gravity;
    public static InternalProjData Construct(): {
        TimeOfCreation: null,
        InitPos: Vector.Zero,
        Radius: 0,
        Targets: [],
        InitVelocity: Vector.Zero,
        VFX: EmptyArray(),
        Gravity: Vector.Zero
        };
}

single struct ProjHitData
{
    public Player Player;
    public Vector Position;
    public Number Time;
    public static ProjHitData Construct(): {
        Player: null,
        Position: Vector.Zero,
        Time: null
    };
}


single struct RaycastPositions
{
    public Number ID;
    public Vector StartPosition;
    public Vector EndPosition;
    public Vector RaycastPosition;
    public Number Interval;
    public static RaycastPositions Construct(): {ID: null, StartPosition: Vector.Zero, EndPosition: Vector.Zero, RaycastPosition: Vector.Zero, Interval: null};
}




globalvar OneTimeCheck[] _OTCQueue = [];
single struct OneTimeCheck
{
    public Number ID;
    public Vector StartPosition;
    public Number ChecksLeft;
    public Number Index;
    //this lets us have an optional last field
    public Number TimeOfLastJITCheck: this[4];
    //Is State Check
    public Boolean IsSC: this.ChecksLeft == 3;
    //Is Player Collision
    public Boolean IsPC: this.ChecksLeft == 2;
    //Is Environment Collision
    public Boolean IsEC: this.ChecksLeft == 1;



    public static void Queue(in Number ID, in Vector StartPosition) {
        _OTCQueue.ModAppend(<OneTimeCheck>{
            ID: ID,
            StartPosition: StartPosition,
            ChecksLeft: 3,
            Index: _OTCQueue.Length
        });
    }

    public static void SpecialQueue(in OneTimeCheck data) {
        _OTCQueue.ModAppend(data);
    }
    public static void ECQueue(in Number ID, in Vector StartPosition) {
        _OTCQueue.ModAppend(<OneTimeCheck>[
            ID,
            StartPosition,
            1,
            _OTCQueue.Length,
            TotalTimeElapsed()
        ]);
    }
    public static void Truncate() {
        _OTCQueue = _OTCQueue.Filter(v => !v.ChecksLeft);
    }

    public static void TruncateByID(in Number ID) {
        _OTCQueue = _OTCQueue.Filter(v => v.ID != ID);
    }
}

