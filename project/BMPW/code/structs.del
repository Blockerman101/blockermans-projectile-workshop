Number Clamp(in Number value, in Number min, in Number max): Min(Max(value, min), max);

public void EffectiveSizeToOversize(ref ProjArgs projArgs) {
    //Data gathered by ispeakpeak
    //https://discord.com/channels/570672959799164958/1253195280573136896/1253203348610486326

    projArgs.VisualRadius = [
        //fx,                                      minSize,    maxSize - minSize
        //<idx>                                    [0]         [1]
        /*ProjFX.BaptisteBioticLauncher         */ [00.150,    (06.750 - 00.150)],  //0
        /*ProjFX.BastionA36TacticalGrenade      */ [00.500,    (07.500 - 00.500)],  //1
        /*ProjFX.EchoStickyBomb                 */ [00.200,    (05.000 - 00.200)],  //2
        /*ProjFX.GenjiShuriken                  */ [00.100,    (02.900 - 00.100)],  //3
        /*ProjFX.LucioSonicAmplifier            */ [00.625,    (05.000 - 00.625)],  //4
        /*ProjFX.MeiIcicle                      */ [00.625,    (09.750 - 00.625)],  //5
        /*ProjFX.MercyCaduceusBlaster           */ [00.025,    (01.200 - 00.025)],  //6
        /*ProjFX.MoiraDamageOrb                 */ [00.650,    (14.000 - 00.650)],  //7
        /*ProjFX.MoiraHealOrb                   */ [00.650,    (14.000 - 00.650)],  //8
        /*ProjFX.OrbProjectile                  */ [00.500,    (04.500 - 00.500)],  //9
        /*ProjFX.OrisaFusionDriver              */ [00.325,    (06.050 - 00.325)],  //10
        /*ProjFX.PharahRocket                   */ [00.075,    (02.350 - 00.075)],  //11
        /*ProjFX.RamattraRavenousVortexSphere   */ [00.300,    (05.750 - 00.300)],  //12
        /*ProjFX.ReinhardtFireStrike            */ [01.300,    (06.500 - 01.300)],  //13
        /*ProjFX.RoadhogScrap                   */ [00.200,    (00.850 - 00.200)],  //14
        /*ProjFX.RoadhogScrapBall               */ [00.450,    (06.000 - 00.450)],  //15
        /*ProjFX.SigmaHypersphere               */ [00.100,    (03.250 - 00.100)],  //16
        /*ProjFX.SymmetraPhotonProjector        */ [00.150,    (05.400 - 00.150)],  //17
        /*ProjFX.ZaryaGraviton                  */ [00.200,    (04.000 - 00.200)],  //18
        /*ProjFX.ZaryaParticleCannon            */ [00.250,    (08.500 - 00.250)]   //19
        //other FX are handled in the .Map
    //if the projFX matches up with the index, set that ele to the corrected size. then, if the ProjFX is a non-proj FX (yeah yeah naming stuff is hard ok?) leave it unchanged, otherwise set it to 99999. Then sort (low to high) and take the first
    //correction is (startSize - minSize)/(maxSize - minSize)
    ].Map((v, idx) => (projArgs.ProjFX == idx) ? ((projArgs.VisualRadius - v.First) / v[1]) : (projArgs.ProjFX < 20 ? 99999 : projArgs.VisualRadius)).Sort(v => v).First;
}


