rule: 'Make big proj'
Event.OngoingPlayer
if (EventPlayer().IsButtonHeld(Button.PrimaryFire))
if (!EventPlayer().IsButtonHeld(Button.Crouch) && !EventPlayer().IsButtonHeld(Button.Interact))
if (EventPlayer() == HostPlayer())
{
    //ProjectileArgs bigProj: {ProjFX: ProjFX.BaptisteBioticLauncher, Radius: 0.3, VisualRadius: 1, Speed: 50, Lifetime: 2.5, ..ProjectileArgs.Default()};
    //CreateCustomProjectile(bigProj);

    //ProjectileArgs electricBall: <ProjectileArgs>{ProjFX: ProjFX.String, String: makeTX(TX[iter]), Color: Color.White, Radius: 0.5, VisualRadius: 3.0, Lifetime: 7,  ..ProjectileArgs.Default()}.CommonPatches();
    ProjectileArgs sphere: {
        SaveDataTicks: 10,
        ProjFX: ProjFX.BaptisteBioticLauncher,
        Color: Color.LimeGreen,
        Radius: 0.5,
        VisualRadius: 0.5,
        Lifetime: 7,
        ..ProjectileArgs.Default()
        }.CommonPatches();

    ProjectileArgs sphereNoGrav: {Gravity: Vector.Zero, ..sphere}.CommonPatches();
    Vector startPos = Vector(5, 0.5, RandomReal(-10, 10));
    ProjectileArgs constArgs: <ProjectileArgs>{StartPosition: startPos, Direction: startPos.Towards(Vector(-20, 6, 0)), ..sphere};
    CreateCustomProjectile(sphere);
    bigProjIDs.ModAppend(lastProjectileID);
    ToggleableLogToInspector("I appended proj " + lastProjectileID);
    MinWait();
    //LoopIfConditionIsTrue();
}

disabled rule: 'iter the iter'
if (HostPlayer().IsButtonHeld(Button.Interact))
{
    iter = (iter + 1)%(TX.Length - 1);
    ToggleableSmallMessage(HostPlayer(), 'iterated the iterator...');
    PlayEffect(HostPlayer(), PlayEffect.BuffImpactSound, null, HostPlayer().EyePosition(), 100);
}

rule: 'Explode big projs!'
Event.OngoingPlayer
if (bigProjIDs.Any(v => projData[v].ProjState == ProjState.Inactive))
{
    ToggleableLogToInspector("Kaboom!");
    UTILS_waitlessIterator = 0;
    while (UTILS_waitlessIterator <= bigProjIDs.Length) {
        ProjData current: projData[bigProjIDs[UTILS_waitlessIterator]];
        if (current.ProjState == ProjState.Inactive)
        {
            PlayEffect(AllPlayers(), PlayEffect.BrigitteRepairPackImpactEffect, Team.Team1, current.Position(), 5);
            PlayEffect(AllPlayers(), PlayEffect.TracerRecallDisappearSound, TeamOf(EventPlayer()), current.Position(), 75);
            //if the projectile hit a player, do stuff, then traverse to next in line (by removing it)
            if (current.Hit.Player)
            {
                SetStatus(current.Hit.Player, EventPlayer(), Status.KnockedDown, 0.2);
                Damage(current.Hit.Player, EventPlayer(), 1);
                ToggleableLogToInspector($"registered that proj {bigProjIDs[UTILS_waitlessIterator]} hit! (trying to hit {current.Hit.Player})");
                //Damage(current.HitPlayer, EventPlayer(), 50);
            }
                bigProjIDs.ModRemoveByIndex(UTILS_waitlessIterator);
        }
        //otherwise, traverse to next in line
        else
        {
            UTILS_waitlessIterator++;
        }
    }
    MinWait();
    LoopIfConditionIsTrue();
}

disabled rule: 'Track helix rockets'
Event.OngoingPlayer
if (EventPlayer().IsFiringSecondary())
if (!EventPlayer().IsButtonHeld(Button.Crouch))
if (EventPlayer() == HostPlayer())
{
    ProjectileArgs myArgs = {ProjFX: ProjFX.PharahRocket, StartPosition: EventPlayer().EyePosition(), Speed: 50, Gravity: Vector.Zero, Lifetime: 2, ..ProjectileArgs.Default()};
    CreateCustomProjectile(myArgs);
    bigProjIDs.ModAppend(lastProjectileID);
}


    Vector RandomSpread(Player player, Number deviation): (player.FacingDirection() * CosineFromDegrees(RandomReal(0, deviation)) + SineFromDegrees(RandomReal(0, deviation)) * (Right().AsWorldVector(player, Transformation.Rotation) * CosineFromDegrees(RandomReal(0, 360)) + CrossProduct(player.FacingDirection(), Left().AsWorldVector(player, Transformation.Rotation)) * SineFromDegrees(RandomReal(0, 360)))).Normalize();


