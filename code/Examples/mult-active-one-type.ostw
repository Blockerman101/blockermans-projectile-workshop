import "../index.ostw";
import "../../customGameSettings.json";

// -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
//somewhat complex case: 1 projectile type, multiple active projectiles
// -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -


# init empty ID array
playervar Number[] freezeProjIDs = [];

//set macro for proj args
ProjectileArgs Freeze: {
    ProjFX: ProjFX.Sphere,
    Color: Color.White,
    VisualRadius: 0.25,
    ..ProjectileArgs.Default()
};

rule: 'Create My Freeze Projectile'
Event.OngoingPlayer
if (EventPlayer().IsButtonHeld(Button.Interact))
{
    # create the projectile
    //common patches modifies your args with things that youll probably want, like gimbal locking fix
    CreateCustomProjectile(Freeze.CommonPatches());

    # append proj ID
    freezeProjIDs.ModAppend(lastProjectileID);

    # add a 0.5s cooldown
    Wait(0.5);

    # alert player that cooldown is over
    SmallMessage(EventPlayer(), "Freeze Projectile Ready!");
}

rule: 'Handle My Freeze Projectile'
Event.OngoingPlayer
# if any of my projs are inactive
if (freezeProjIDs.Any(v => ProjData.Get(v).ProjState == ProjState.Inactive)) //ProjData.Get(v).Projstate is the same as projData[v].ProjState
{
    # find the first inactive ID in freezeProjIDs
    Number currentID = freezeProjIDs.Filter(v => ProjData.Get(v).ProjState == ProjState.Inactive).First;

    //make a convenient macro for data
    //TIP: dont make variables of type ProjData, since that will compile to several variables and take up more eles than .Get()-ing whatever you need
    ProjData currentData: ProjData.Get(currentID);

    # freeze the hit player
    SetStatus(currentData.Hit.Player, EventPlayer(), Status.Frozen, 3);

    # after handling, remove that ID from the list
    freezeProjIDs.ModRemoveByValue(currentID);

    # if youre worried about crashing, add a MinWait()! (Wait(False, Ignore Condition);)
    # note that this limits your handlers rate to 62.5 projs per player per second
    //MinWait();

    LoopIfConditionIsTrue();
}
