import "index.ostw";

globalvar private RaycastPositions _TEMP_tempPositions;
globalvar Number _envCollisionIndex;
//A circular linked list for EC
globalvar EnvironmentCollision[] _envCollisionList = [];

//Rotates a vector along a given axis
public Vector RotateVector(in Vector vector, in Vector axis, in Number radians) {
    return (vector * CosineFromRadians(radians)) + (CrossProduct(axis, vector) * SineFromRadians(radians)) + (axis * DotProduct(axis, vector) * (1 - CosineFromRadians(radians)));
}


rule: '[BMPW] Reset _envCollisionIndex on lap end'
if (_envCollisionList.Length)
//if (currentTick == 0 || currentTick == 1)
if (!currentTick)
{
    _envCollisionIndex = 0;
    LogToInspector($"Lap ended. (Index returned to 0) (TTE: {time})");
}


rule: '[BMPW] Check EC'
//This might fix a (potential?) bug
if (_envCollisionIndex < _envCollisionList.Length)
if (_envCollisionList[_envCollisionIndex].Time == currentTick || _OTCQueue.Any(v => v.ChecksLeft.First))
{
    //If the proj radius is below this, skip extra EC
    Number thresholdForExtraEC: 1.0;

    Boolean IsOTC: _OTCQueue.Filter(v => v.ChecksLeft.First).Length;
    OneTimeCheck OTCData: _OTCQueue.Filter(v => v.ChecksLeft.First).First;


    _TEMP_tempPositions.ID = (IsOTC ? OTCData.ID : _envCollisionList[_envCollisionIndex].ID);
    Number ID: _TEMP_tempPositions.ID;

    Number _interval: (interval + 0.032);
    //can use this field (RaycastPositions.Interval) temporarily, to save eles
    _TEMP_tempPositions.Interval = _interval;

    _TEMP_tempPositions.StartPosition = (IsOTC ? OTCData.StartPosition : projData[ID].Position());
    Vector StartPosition:_TEMP_tempPositions.StartPosition;

    //called twice, but its cosmetic
    Color color:                Color.White;

    //called once
    Number TimeOfLastJITCheck:  null;



    ProjData current: projData[ID];



    //EC starts
    Number lapCount: 4;

    WaitlessForLoop(0, i => i < lapCount, 1, currentLap => {
        LogToInspector($"On lap {currentLap}");

        

        //base positions set above, before shifting
        
        _TEMP_tempPositions.EndPosition = projData[ID].PositionAtTime(_TEMP_tempPositions.Interval);

        Vector currentDirection: (_TEMP_tempPositions.EndPosition - _TEMP_tempPositions.StartPosition).Normalize();
        

        //This evaluates to the projectiles relative right
        //action for nonzero EC
        _TEMP_tempPositions.Interval = CrossProduct(Down(), currentDirection);
        Vector relativeRight: <Vector>_TEMP_tempPositions.Interval;

        Number rotationAmountsForCurrentlap: [null, 0, 2*Pi()/3, 4*Pi()/3][currentLap];

        //Shift start/end pos of laps 1 through 3 by rotating them
        Vector startRotation: current.ReadOnly.Radius * Normalize(RotateVector(relativeRight, currentDirection, rotationAmountsForCurrentlap)) * 2 / SquareRoot(3);

        Vector endRotation: current.ReadOnly.Radius * Normalize(RotateVector(relativeRight, currentDirection, rotationAmountsForCurrentlap + Pi()/3)) * 2 / SquareRoot(3);
        
        //Shift start/end pos along the direction of the check
        Vector verticalOffset: (currentDirection * current.ReadOnly.Radius / SquareRoot(6));

        //A vertical shift to make the start and end points be at the end of the capsule
        Vector firstLapShift: currentDirection * current.ReadOnly.Radius;

        //action for nonzero EC
        _TEMP_tempPositions.StartPosition += !currentLap ? -1*firstLapShift : (startRotation - verticalOffset);
        //action for nonzero EC
        _TEMP_tempPositions.EndPosition += !currentLap ? firstLapShift : (endRotation + verticalOffset);


        //This will need to include targets in order for their objects to be tracked
        _TEMP_tempPositions.RaycastPosition = RayCastHitPosition(_TEMP_tempPositions.StartPosition, _TEMP_tempPositions.EndPosition, projData[ID].ReadOnly.Targets, null, true);
        
        //action for nonzero EC (not needed if interval isnt reset to smth else)
        _TEMP_tempPositions.Interval = _interval;

        //LogToInspector($"coll checked! (ID: {ID}, Check: {projData[ID].DEBUG_ECCheck + 1}, CurrentTII: {currentTick}, interval: {_TEMP_tempPositions.Interval}, TTE: {time})");
        LogToInspector($"coll checked! (ID: {ID}, CurrentTII: {currentTick}, interval: {_TEMP_tempPositions.Interval}, TTE: {time})");
        
        



        //Structuring the state check like this allows us to reuse the projs _TEMP_tempPositions.StartPosition instead of recalculating it
        //StateCheck(ID, _TEMP_tempPositions.StartPosition);

            //if (IsTrueForAny([_TEMP_tempPositions.StartPosition, _TEMP_tempPositions.EndPosition, _TEMP_tempPositions.RaycastPosition], ArrayElement() == Vector.Zero)) {LogToInspector("!--POSITIONS REGISTERED ZERO--!");}


            CreateBeamEffect(HostPlayer(), BeamType.GrappleBeam, _TEMP_tempPositions.StartPosition, _TEMP_tempPositions.RaycastPosition, Color.Red, EffectRev.None);


            //projData[ID].DEBUG_ECCheck++;
            //CreateInWorldText(HostPlayer(), $"Proj {ID} EC {projData[ID].DEBUG_ECCheck}" + (IsOneTimeCheck ? " (OTC!)" : ""), _TEMP_tempPositions.StartPosition + Up() * 0.2 * projData.Length, 1, Clipping.DoNotClip, InworldTextRev.None, Color.White, Spectators.DefaultVisibility);
            //projData[ID].ReadOnly.VFX.ModAppend(LastCreatedEntity());
            //CreateEffect(HostPlayer(), Effect.Sphere, color, _TEMP_tempPositions.StartPosition, 0.25, EffectRev.None);
            //projData[ID].ReadOnly.VFX.ModAppend(LastCreatedEntity());
            

    //        if ([_TEMP_tempPositions.StartPosition, _TEMP_tempPositions.EndPosition, _TEMP_tempPositions.RaycastPosition].IsTrueForAny(v => v == Vector.Zero)) {LogToInspector($"POSITIONS REGISTERED ZERO");}
        if (_TEMP_tempPositions.RaycastPosition != _TEMP_tempPositions.EndPosition) 
        {
//            projData[ID].HitPlayer = RayCastHitPlayer(_TEMP_tempPositions.StartPosition, _TEMP_tempPositions.EndPosition, projData[ID].ReadOnly.Targets, null, true);
//            //Perform a player-collision check
//            if (projData[ID].HitPlayer)
//            {
//                //do player destruction
//            }


            //By making the queue time {offset} shorter, you avoid false positives with PC (take the case of a projectile hitting reins shield)
            //^ not needed if you just include objs in PD
            //Number offset: 0.016*0;
            //Number timeToDestroy: _TEMP_tempPositions.Interval * Min(1, Max(0, LinearInterpolate(0, 1, (_TEMP_tempPositions.StartPosition.DistanceTo(_TEMP_tempPositions.RaycastPosition) / _TEMP_tempPositions.StartPosition.DistanceTo(_TEMP_tempPositions.EndPosition))))) - offset;
            Number timeToDestroy: _TEMP_tempPositions.Interval * Min(1, Max(0, LinearInterpolate(0, 1, (_TEMP_tempPositions.StartPosition.DistanceTo(_TEMP_tempPositions.RaycastPosition) / _TEMP_tempPositions.StartPosition.DistanceTo(_TEMP_tempPositions.EndPosition)))));
            ProjDestructor.Queue(ID, timeToDestroy, TypeOfDestruction.Environment, _TEMP_tempPositions.Interval - timeToDestroy, TimeOfLastJITCheck); //Cant add an offset for visuals because it would mess up ricochets
            LogToInspector($"Collided! (Proj {ID} queued with {timeToDestroy} seconds\n(Current Tick {(TotalTimeElapsed() / 0.016).Floor()} with {((timeToDestroy) / 0.016).Floor()} ticks to destruction\nExpected to be destroyed at tick {((time + timeToDestroy) / 0.016).Floor()}))");
            //break;


            //stop laps on collision (UTILS_waitlessIterator is currentLap)
            UTILS_waitlessIterator = lapCount;
        }


    //Break loop, to prevent outer raycasts, if proj radius is below a certain threshold (UTILS_waitlessIterator is currentLap)

    if (current.ReadOnly.Radius < thresholdForExtraEC) {
        UTILS_waitlessIterator = lapCount;
    }


    });
    LogToInspector($"LOOP EXITED");






    //EC ends
    
    if (IsOTC) {
        //set current OTC EC ChecksLeft (idx 0) to false
        LogToInspector("IsOTC");
        _OTCQueue[_OTCQueue.Map(v => v.ChecksLeft.First ? CurrentArrayIndex() : -1).Filter(v => v != -1).First].ChecksLeft[0] = false;
    }
    else {
        _envCollisionIndex++; //Traverse to the next projectile
    }


    //WaitUntil((diff()) && _envCollisionIndex < _envCollisionList.Length, interval - (time%interval)); //Wait until the next proj is ready to be checked, and if either if the loop ends, or until there is a value at _envCollisionList[_envCollisionIndex].Time

    //Heres the reason why '&& _envCollisionIndex < _envCollisionList.Lengh' is needed: First off, this code makes sure that your not reading an out-of-scope index.
    //Take the case where there is 1 projectile, with a ProjTick of 0. When the Current Tick is 0, it will check Proj 1, then traverse to Proj 2.
    //Because there is no Proj 2, diff(1) corresponds to _envCollisionList[1].Time == 0 -> null == 0 -> true. Therefore, the WaitUntil never happens, and it loops to the next check.
    //This happens an infinite amount of times (with 0 waits inbetween), crashing the server.
    LoopIfConditionIsTrue();
    
    Wait(0, WaitBehavior.RestartWhenTrue);
    LoopIfConditionIsTrue();
}







//Boolean approxEqual(in Number one, in Number two, in Number leniency): ((one - two).Abs() <= leniency);
Number rawInterval: 0.5; //How often to check for collision
Number interval: ((rawInterval / 0.016).Ceil() * 0.016); //Rounded up to the nearest multiple of 0.016 (Rounded up to the nearest tick)

//Cant use tte because of the bug with chased vars in conditions
Number time: TotalTimeElapsed();
Number currentTick: ((time%interval) / 0.016).Floor();