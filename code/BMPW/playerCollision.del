import "index.ostw";

//a list of proj IDs
globalvar Number[] _complexProjs = EmptyArray();

rule: '[BMPW] Player Collision'
if (_complexProjs.Length)
if (_OTCQueue.Any(v => v.PCCheck))
{
    Number tickCount: 5;
    Number currentTick: (TotalTimeElapsed()/0.016).Floor()%tickCount;
    
    Boolean IsOTC: _OTCQueue.Filter(v => v.PCCheck).Length;
    OneTimeCheck OTCData: _OTCQueue.Filter(v => v.PCCheck).First;

    WaitlessForLoop(0, i => (currentTick + i * tickCount < _complexProjs.Length) || IsOTC, 1, i => {

        Number ID! = IsOTC ? OTCData.ID : _complexProjs[currentTick + tickCount * i];

        //calculations: https://www.desmos.com/3d/c7ypcrhnqw
        ProjData proj: projData[ID];

        _playerCollisionData.Position = IsOTC ? OTCData.StartPosition : proj.Position();
        
        _playerCollisionData.Target = proj.ReadOnly.Targets.Sort(v => v.DistanceTo(_playerCollisionData.Position)).First;
        Vector feetToEyes: (_playerCollisionData.Target.Position().Towards(_playerCollisionData.Target.EyePosition()));
        //The projectile pos, projected onto a line from the feet of the target to the eyes of the target
        Vector projectedPos: _playerCollisionData.Target.Position() + feetToEyes * Clamp(DotProduct(feetToEyes, _playerCollisionData.Position - _playerCollisionData.Target.Position())/DotProduct(feetToEyes, feetToEyes), 0, 1);
        
        //Vector from projPos towards projectedPos
        _playerCollisionData.ShiftForRaycastPositions = _playerCollisionData.Position.Towards(projectedPos);
        
        //Shift
        _playerCollisionData.ShiftForRaycastPositions = Clamp(_playerCollisionData.ShiftForRaycastPositions.Magnitude, 0, proj.ReadOnly.Radius) * _playerCollisionData.ShiftForRaycastPositions.Normalize();
        
        CreateBeamEffect(LocalPlayer(), BeamType.GoodBeam, EvaluateOnce(_playerCollisionData.Position + _playerCollisionData.ShiftForRaycastPositions), EvaluateOnce(proj.PositionAtTime(0.016*tickCount) + _playerCollisionData.ShiftForRaycastPositions), null, EffectRev.VisibleToPositionAndRadius);

        projData[ID].HitPlayer = RayCastHitPlayer(
            _playerCollisionData.Position + _playerCollisionData.ShiftForRaycastPositions,
            proj.PositionAtTime(0.016*tickCount) + _playerCollisionData.ShiftForRaycastPositions,
            proj.ReadOnly.Targets,
            null,
            true);
        //PlayEffect(HostPlayer(), PlayEffect.GoodExplosion, Color.White, proj.Position(), 0.5);
        //PlayEffect(HostPlayer(), PlayEffect.GoodExplosion, Color.White, proj.PositionAtTime(0.016*tickCount), 0.5);
        if (proj.HitPlayer)
        {
            ProjDestructor.Destroy(ID);
            LogToInspector($"Proj {ID} hit {proj.HitPlayer}!");
        }
        _OTCQueue[_OTCQueue.Map(v => v.PCCheck ? CurrentArrayIndex() : -1).Filter(v => v != -1).First].PCCheck = false;
        LogToInspector($"set PC of proj {ID} to false");
        OneTimeCheck.Truncate();
        LogToInspector("truncated OTC");

    });

    MinWait();
    LoopIfConditionIsTrue();
}






//If you need to store a value to use it multiple times in the same tick, this var can be used for that as well
globalvar (Any|Any[]) UTILS_waitlessIterator;
public void NestedWaitlessForLoop(in Number start, const Number => Boolean end, in Number step, const (Number|Number[]) => void func, in Number nestedLevel=0) {
    UTILS_waitlessIterator[nestedLevel] = start;
    while (end(UTILS_waitlessIterator[nestedLevel]))
    {
        func(UTILS_waitlessIterator[nestedLevel]);
        UTILS_waitlessIterator[nestedLevel] += step;
    }  
}

public void WaitlessForLoop(in Number start, const Number => Boolean loopWhileThisIsTrue, in Number step, const (Number|Number[]) => void func) {
    UTILS_waitlessIterator = start;
    while (loopWhileThisIsTrue.Invoke(UTILS_waitlessIterator))
    {
        func(UTILS_waitlessIterator);
        UTILS_waitlessIterator += step;
    }  
}