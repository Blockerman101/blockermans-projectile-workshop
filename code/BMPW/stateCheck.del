import "index.ostw";
Number speed(in Number ID): projData[ID].GetReadOnly().Velocity.Magnitude;

//The interval for the checks, in seconds (15 ticks / 62.5tps = 0.24s)
Number inter: 0.24;

//projRad + baseRad + scalar * speed * intervalOfSC
Number rad(in Number ID): projData[ID].GetReadOnly().Radius + 10 + 1.0 * speed(ID) * inter;

//The faster a proj is going, the more you can assume ahead of it to be the checked position
Vector pos(in Number ID): projData[ID].PositionAtTime(inter * Min(1, Min(85, speed(ID)) / 85));


rule: '[BMPW] State Check'
if (((TotalTimeElapsed()/0.016).Floor()%15 < _envCollisionList.Length) || _OTCQueue.Any(v => v.IsSC))
{
    Number tickCount: 15;
    Number currentTick: (TotalTimeElapsed()/0.016).Floor()%tickCount;

    Boolean IsOTC: _OTCQueue.Filter(v => v.IsSC).Length;
    OneTimeCheck OTCData: _OTCQueue.Filter(v => v.IsSC).First;

    WaitlessForLoop(0, i => (currentTick + tickCount * i < _envCollisionList.Length) || IsOTC, 1, i => {

        Number ID! = IsOTC ? OTCData.ID : _envCollisionList[currentTick + tickCount * i].ID;
        
        if (projData[ID].GetReadOnly().Targets.Any(v => v.DistanceTo(pos(ID)) <= rad(ID)))
        {
            if (_complexProjs.All(v => v != ID))
            {
                _complexProjs.ModAppend(ID);
                //This should be the same as ticks in PC
                //checkPCollision(ID, 5);
                //_OTCQueue[_OTCQueue.Map(v => v.SCheck ? CurrentArrayIndex() : -1).Filter(v => v != -1).First].SCheck = false;
            }
            if (IsOTC)
            {
                _OTCQueue[OTCData.Index].ChecksLeft = 2;
            }
        }
        else
        {
            _complexProjs.ModRemoveByValue(ID);
            //skip PC if proj is simple
            if (IsOTC)
            {
                _OTCQueue[OTCData.Index].ChecksLeft = 1;
            }
        }
        LogToInspector($"proj {ID} checksleft is {OTCData.ChecksLeft}");
        //LogToInspector($"Checked state of proj {i} (TTE: {time})");
    });
    MinWait();
    LoopIfConditionIsTrue();
}