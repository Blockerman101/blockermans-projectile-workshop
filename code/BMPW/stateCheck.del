import "index.ostw";
Number speed(in Number ID): projData[ID].ReadOnly.Velocity.Magnitude;

//The interval for the checks, in seconds (15 ticks / 62.5tps = 0.24s)
Number inter: 0.24;

//projRad + baseRad + scalar * speed * intervalOfSC
Number rad(in Number ID): projData[ID].ReadOnly.Radius + 10 + 1.0 * speed(ID) * inter;

//The faster a proj is going, the more you can assume ahead of it to be the checked position
Vector pos(in Number ID): projData[ID].PositionAtTime(inter * Min(1, Min(85, speed(ID)) / 85));


rule: '[BMPW] Update State'
if (_envCollisionList.Length)
//if (_OTCQueue.First.ChecksLeft)
{

    SpreadOverTicks(_envCollisionList, 15, i => {
        //i is the index of the array entered
        //StateCheck(i.ID, projData[i.ID].Position());
            //Criteria for complex state
        if (projData[i.ID].ReadOnly.Targets.Any(v => v.DistanceTo(pos(i.ID)) <= rad(i.ID)))
        {
            if (_complexProjs.All(v => v != i.ID))
            {
                _complexProjs.ModAppend(i.ID);
                //This should be the same as ticks in PC
                //checkPCollision(ID, 5);
            }
        }
        else
        {
            _complexProjs.ModRemoveByValue(i.ID);
        }
        //LogToInspector($"Checked state of proj {i} (TTE: {time})");
    });
}