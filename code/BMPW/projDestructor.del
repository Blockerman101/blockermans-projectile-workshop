import "../index.ostw";
globalvar ProjDestructor[] _projDestructorQueue = []; 

rule: '[BMPW] Destructor - Destroy Proj'
Event.OngoingGlobal
if (_projDestructorQueue.Length)
if (_projDestructorQueue.First.time <= TotalTimeElapsed())
{
    _TEMP_tempPositions.ID = _projDestructorQueue.First.ID;
    Number ID: _TEMP_tempPositions.ID;
    ProjDestructor current: _projDestructorQueue.First;

    //JIT checks will be limited to this much (at least) time between them
    Number JITTimeout: 0.5;

    //JIT check for EC
    if (current.TypeOfDestruction == TypeOfDestruction.Environment && (TotalTimeElapsed() - current.TimeOfLastJITCheck > JITTimeout))
    {
        ToggleableSmallMessage(HostPlayer(), "Doing JIT in Destructor!!");
        ToggleableLogToInspector($"\n\nENTERED OTC\n\n");
        //An alternative solution is checking earlier temporally rather than retrospectively back-checking (with timeBackwards & timeForwards)
            //This has the benefit of higher accuracy in situations where pets (shields, turrets, etc) are moving towards the projectile
            //However, we're considering this an edge-case and currently not worth the extra load

        Number timeBackwards: -0.1;
        Number timeForwards:   0.1;
        _TEMP_tempPositions.StartPosition = projData[ID].PositionAtTime(timeBackwards);
        _TEMP_tempPositions.EndPosition = projData[ID].PositionAtTime(timeForwards);
        //This will need to include targets in order for their objects to be tracked
        _TEMP_tempPositions.RaycastPosition = RayCastHitPosition(_TEMP_tempPositions.StartPosition, _TEMP_tempPositions.EndPosition, projData[ID].Internal.Targets, null, true);

        //CreateBeamEffect(HostPlayer(), BeamType.BrigitteFlailChainBeam, _TEMP_tempPositions.StartPosition, _TEMP_tempPositions.RaycastPosition, Color.Red, EffectRev.None);
        //    projData[ID].Internal.VFX.ModAppend(LastCreatedEntity());
        //CreateEffect(HostPlayer(), Effect.Sphere, Color.Purple, _TEMP_tempPositions.RaycastPosition, 0.25, EffectRev.None);
        //    projData[ID].Internal.VFX.ModAppend(LastCreatedEntity());
        ////CreateBeamEffect(HostPlayer(), BeamType.GoodBeam, (_TEMP_tempPositions.StartPosition + _TEMP_tempPositions.EndPosition) / 2, _TEMP_tempPositions.EndPosition, Color.Black, EffectRev.None);
        //    projData[ID].Internal.VFX.ModAppend(LastCreatedEntity());
        //CreateEffect(HostPlayer(), Effect.Sphere, Color.Orange, (_TEMP_tempPositions.StartPosition + _TEMP_tempPositions.EndPosition) / 2, 0.15, EffectRev.None);
        //    projData[ID].Internal.VFX.ModAppend(LastCreatedEntity());

        Number timeToDestroy: (timeBackwards + (timeBackwards.Abs() + timeForwards) * Min(1, Max(0, LinearInterpolate(0, 1, (_TEMP_tempPositions.StartPosition.DistanceTo(_TEMP_tempPositions.RaycastPosition) / _TEMP_tempPositions.StartPosition.DistanceTo(_TEMP_tempPositions.EndPosition))))));
        //ToggleableLogToInspector($"proj {ID}\nold: {_projDestructorQueue.First.extra}\nnew: {_TEMP_tempPositions.RaycastPosition}");

        //If we didn't collide with something, prevent destruction & check the remainder of the projs EC interval
        if (_TEMP_tempPositions.RaycastPosition == _TEMP_tempPositions.EndPosition)
        {
            ToggleableLogToInspector($"prevented destruction of proj {ID}");

            //OTC here
            OneTimeCheck.ECQueue(ID, _TEMP_tempPositions.StartPosition);
            ToggleableSmallMessage(HostPlayer(), "queued OTC from destructor");
            ToggleableLogToInspector("queued OTC from destructor");

            _projDestructorQueue.ModRemoveByIndex(0);
            MinWait();
            LoopIfConditionIsTrue();
            Abort();
        }

        //If we did collide with something, update that queue (and set it to not JIT check again)
        //Fine tunes the destruction time
        else if (timeToDestroy > 0.016)
        {
            ToggleableLogToInspector($"recalculated des of proj {ID}\nTo be destroyed in {timeToDestroy}s");

            //Update current, doing time last just to be safe

            _projDestructorQueue[0] = {
                time: current.time + timeToDestroy,
                TypeOfDestruction: TypeOfDestruction.JustInTime,
                ..current
            };
            //_projDestructorQueue.First.time += timeToDestroy;
            ProjDestructor.SortQueue();

            MinWait();
            LoopIfConditionIsTrue();
            Abort();
        }

        //If the timeToDestroy is <= 0, fine-tune some data
        //This will make the destruction position / ricochets more accurate
        else
        {
            //FINE TUNE HERE
            //use more accurate hit position if possible
            projData[ID].Hit.Position = _TEMP_tempPositions.RaycastPosition;
        }
    }
    else
    {
        //if more accurate hit position isnt possible (not TypeOfDestruction.Environment), fallback to .Position()
        projData[ID].Hit.Position = projData[ID].Position();
    }

    projData[ID].Hit.Time = TotalTimeElapsed();


    DestroyEffect(projData[ID].Internal.VFX);
    DestroyInWorldText(projData[ID].Internal.VFX);


    //ToggleableLogToInspector($"Destroyed fx {projData[ID].Internal.VFX} from proj {ID}");
    projData[ID].ProjState = ProjState.Inactive;
    _complexProjs.ModRemoveByValue(ID);

    //For decrementing the _envCollisionIndex of _envCollisionList
    Boolean[] reqsForDec: [
        //_envCollisionList.Length > 1,
        ECCurrentTick >= _envCollisionList[_envCollisionList.Map(v => v.ID).IndexOf(ID)].Time,
        _envCollisionIndex //make sure it isnt 0, because if it was it would go to index -1
    ];
    if (IsTrueForAll(reqsForDec, ArrayElement())) {
        //ToggleableLogToInspector($"Dec'd Index. (Index {_envCollisionList.Map(v => v.ID).IndexOf(ID)} with ID {ID}, Index: {_envCollisionIndex} -> {_envCollisionIndex + 1})");
        _envCollisionIndex--;
        }

    //This doesnt need to maintain indices like projData, so when a projectile is made Inactive, its simply removed from this array
    EnvironmentCollision.ClearFromQueue(ID);


    ToggleableLogToInspector($"Destroyed Proj {ID} (Tick {(TotalTimeElapsed()/0.016).Floor()})");
    //Do this last, ID is tied to ProjDestructor
    _projDestructorQueue = _projDestructorQueue.Filter(v => v.ID != ID);
    //_projDestructorQueue.ModRemoveByIndex(0); //ts does NOT work when theres >1 queue for any proj
    
    MinWait();    
    LoopIfConditionIsTrue();
}

rule: '[BMPW] Destructor - Make Projectiles Unsafe'
//v + n, n is the extra time
//if (projData.Map(v => v.ProjState).Any(v => v == ProjState.Inactive))
//if (projData.Map(v => v.Hit.Time).Any((v, idx) => idx && TotalTimeElapsed() > (v + 5)))
if (projData.Any(v => (v.ProjState == ProjState.Inactive) && (TotalTimeElapsed() > (v.Hit.Time + 5))))
{
    projData = projData.Map(v => {
        ProjState: (v.ProjState == ProjState.Inactive && (TotalTimeElapsed() > v.Hit.Time + 5)) ? ProjState.Unsafe : v.ProjState,
        ..v
    });
    SmallMessage(HostPlayer(), "Unsafe rule triggered!");

    //The closest power of 2 to the size of projData, rounded down (so if length is 25, this is 16, so you can check)
    UTILS_waitlessIterator = [4, 8, 16, 32, 64, 128, 256].Filter((v, idx) => projData.Length - 1 > v).Last;
    Number floorPowerOfTwo: UTILS_waitlessIterator;

    //Half the size of the database, if possible
    if (projData.All(v => v.ProjState == ProjState.Unsafe || CurrentArrayIndex() <= floorPowerOfTwo) && floorPowerOfTwo)
    {
        //ToggleableLogToInspector($"size: {projData.Length}, FPOT: {floorPowerOfTwo}");

        //want the indices from 0 through floorPowerOfTwo
        UTILS_waitlessIterator = projData.Map(v => CurrentArrayIndex() <= floorPowerOfTwo ? CurrentArrayIndex() : -1).Filter(i => i != -1);
        Number[] indexes: UTILS_waitlessIterator;
        projData = indexes.Map(v => projData[v]);
        //projData = projData[indexes];
        //projData = projData.Filter((v, idx) => idx < floorPowerOfTwo);
        ToggleableLogToInspector($"Made size smaller! (shrank to {floorPowerOfTwo}, from {indexes.First} through {indexes.Last})");
    }

    MinWait();
    LoopIfConditionIsTrue();
}


rule: '[BMPW] Destructor - Clear Projectile Data'
Event.OngoingGlobal
if (projData.Length > 1)
if (!_projConstructorQueue.Length)
if (projData.All(v => v.ProjState == ProjState.Unsafe || !CurrentArrayIndex())) //If all real projectiles are inactive
{
    Wait(0.25, WaitBehavior.AbortWhenFalse);
    DestroyEffect(projData.Map(v => v.Internal.VFX));
    WipeData();

    MinWait();
    LoopIfConditionIsTrue();
}

private void WipeData() {
    projData = [ProjData.Construct()];
    //projData_VFX = [0];

    _projConstructorQueue = [];
    _projDestructorQueue = [];

    _envCollisionList = [];
    _envCollisionIndex = 0;

    _complexProjs = [];
    
    lastProjectileID = 0;
}