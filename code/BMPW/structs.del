//A good design philosophy is to reference specific states, rather "Not" states
//projData[ID].ProjState == ProjState.Engaged //Good
//projData[ID].ProjState != ProjState.Inactive //Bad
//This helps future-proof
//The syntax wont be the exact same for users, but its still good info to have

enum ProjState
{
    NULL, //Debugging
    Active, //Projectile is processing passively/simply - run EC, update ProjState
    Inactive //Projectile was spawned, then was destroyed
    //Complex //Projectile is processing special things - player collision

}



single struct ProjectileArgs
{
    private Number _ProjID;
        public Number _GetID() {return _ProjID;}
        public ref void _SetID(in Number ID) {_ProjID = ID;}
    public ProjFX ProjFX;
    public Color ColorForFX;
    public Vector StartPosition;
    public Vector Direction;
    public Player[] Targets;
    //public Number DamageAmount;
    public Number Radius;
    public Number VisualRadius;
    public Number Speed;
    public Number Lifetime;
    //public Number Knockback;
    //projectiles with 0 gravity must use Vector.Zero, otherwise type-errors will break the proj
    public Vector Gravity;
    //private Number ProjID;
    private Number _TimeOfCall;
        //get Time of Call
        public Number _GetTOC() {return _TimeOfCall;}

        //set Time of Call
        public ref void _SetTOC(in Number time) {_TimeOfCall = time;} 
    public static ProjectileArgs Construct(): {
        ProjFX: ProjFX.OrbProjectile, 
        ColorForFX: null,
        StartPosition: Vector.Zero, 
        Direction: Vector.Zero, 
        Targets: null, 
        Radius: 0, 
        VisualRadius: 0,
        Speed: 0, 
        Lifetime: 0, 
        Gravity: Vector.Zero, 
        _ProjID: 0, 
        _TimeOfCall: 0
        };
    public static ProjectileArgs Default(in Player player=EventPlayer()): {
        ProjFX: ProjFX.OrbProjectile, 
        ColorForFX: null,
        StartPosition: EyePosition(player), 
        Direction: player.FacingDirection(), 
        Targets: AllPlayers(OppositeTeamOf(TeamOf(player))), 
        Radius: 0,
        VisualRadius: 0.5,
        Speed: 20, 
        Lifetime: 3, 
        Gravity: Down() * 5, 
        _ProjID: null, 
        _TimeOfCall: null
        };

    public ProjectileArgs CommonPatches(in Player player=EventPlayer()) {
        return {
            StartPosition: this.StartPosition + this.Direction * this.Radius, //ensure proj starts out of player
            Direction: VerticalFacingAngleOf(player) <= -88.9 ? Up() : (VerticalFacingAngleOf(player) >= 88.9 ? Down() : this.Direction), //fix gimbal locking
            ..this
        };
    }
}

globalvar PCData _playerCollisionData = EmptyArray();
single struct PCData
{
    public Vector Position;
