import "index.ostw";

globalvar Number UTILS_tte;
rule: '[BMPW] Initialize TTE var'
{
    ChaseVariableAtRate(UTILS_tte, 99999, 1, RateChaseReevaluation.None);
}
rule: '[BMPW] Sync TTE var (interval)'
if (EntityCount())
{
    SyncTTE();
    Wait(0.5);
    LoopIfConditionIsTrue();
}
void SyncTTE() {
    UTILS_tte = TotalTimeElapsed();
}


