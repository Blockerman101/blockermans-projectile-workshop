enum TypeOfDestruction
{
    NULL,
    Environment,
    Player,
    Timeout,
    JustInTime
}

single struct ProjDestructor
{
    public Number ID;
    public Number time; //The relative time to destroy this projectile
    public TypeOfDestruction TypeOfDestruction;
    //the length (in time) of the check subtracted by how much of the check was checked
    //equivalent to scopedInterval - timeToDestroy
    public Number TimeLeft;
    public Number TimeOfLastJITCheck;
    //Queue proj to be destroyed, the proj will be destroyed `time` seconds from when the method is called

    //public static void Queue(in Number ID, in Number time) {_projDestructorQueue = _projDestructorQueue.Append({ID: ID, time: UTILS_tte + time}).Sort(v => v.time);} //TTE() is automatically included, so the extra time is relative
    public static void Queue(in Number ID, in Number time, in TypeOfDestruction typeOfDestruction, in Number TimeLeft=null, in Number TimeOfLastJITCheck=null) {_projDestructorQueue = _projDestructorQueue.Append(<ProjDestructor>{ID: ID, time: UTILS_tte + time, TypeOfDestruction: typeOfDestruction, TimeLeft: TimeLeft, TimeOfLastJITCheck: TimeOfLastJITCheck}).Sort(v => v.time);}
    public static void QueueRaw(in Number ID, in Number time, in TypeOfDestruction typeOfDestruction, in Number TimeLeft=null, in Number TimeOfLastJITCheck=null) {_projDestructorQueue = _projDestructorQueue.Append(<ProjDestructor>{ID: ID, time: time, TypeOfDestruction: typeOfDestruction, TimeLeft: TimeLeft, TimeOfLastJITCheck: TimeOfLastJITCheck}).Sort(v => v.time);} //Queue without the automated TTE, letting you have full control over when, specifically, the proj is deleted
    public static void SortQueue() {_projDestructorQueue = _projDestructorQueue.Sort(v => v.time);}
    
    //Destroy proj ASAP
    public static void Destroy(in Number ID) {_projDestructorQueue = _projDestructorQueue.Append(<ProjDestructor>{ID: ID, time: null, TypeOfDestruction: null, TimeLeft: null, TimeOfLastJITCheck: null}).Sort(v => v.time);}
    public static void ClearFromQueue(in Number ID) {_projDestructorQueue = _projDestructorQueue.Filter(v => v.ID != ID);}
}

struct ProjData
{
    public Number time: (UTILS_tte - this.TimeOfCreation);
    public ProjState ProjState;

    //public PositionsForProjData ControlPoints;
    //public RarelyChangeProjData RarelyChange;
    public ReadOnlyProjData ReadOnly;
    public Number TimeOfCreation;

    public Player HitPlayer; //this is for testing, not intended for user
    //public Vector Position: (
    //    ((this.ReadOnly.Lifetime - (UTILS_tte - this.TimeOfCreation))/this.ReadOnly.Lifetime)*(((this.ReadOnly.Lifetime - (UTILS_tte - this.TimeOfCreation))/this.ReadOnly.Lifetime)*(this.RarelyChange.Bezierp0) + ((UTILS_tte - this.TimeOfCreation)/this.ReadOnly.Lifetime)*this.RarelyChange.Bezierp1) + ((UTILS_tte - this.TimeOfCreation)/this.ReadOnly.Lifetime)*(((this.ReadOnly.Lifetime - (UTILS_tte - this.TimeOfCreation))/this.ReadOnly.Lifetime)*this.RarelyChange.Bezierp1 + ((UTILS_tte - this.TimeOfCreation)/this.ReadOnly.Lifetime)*this.RarelyChange.Bezierp2)
    //);
    //public Vector Position: b0;

    //A macro for caculating the projectiles position
    //public Number DEBUG_ECCheck;
    public Vector Position(in ReadOnlyProjData overrideReadOnlyVar=ReadOnly): (overrideReadOnlyVar.InitPos + time * (overrideReadOnlyVar.Velocity + overrideReadOnlyVar.Gravity * time / 2));

    //A variable for the projectiles position, updated every [interval] in the EC
    public Vector PositionAtTime(in Number extraTime): this.ReadOnly.InitPos + (time + extraTime) * (this.ReadOnly.Velocity + this.ReadOnly.Gravity * (time + extraTime) / 2);
    //public Vector PositionAtTime(in Number time): b0Time(time); //The above macro, "Position", assumes that "time" is 0. Inputting 0.5 for this will get you the position of the projectile 0.5s in the future

    public Vector PositionAtRawTime(in Number time): this.ReadOnly.InitPos + time * (this.ReadOnly.Velocity + this.ReadOnly.Gravity * time / 2);

   
    //public static ProjData Construct(): {ProjState: ProjState.NULL, ReadOnly: ReadOnlyProjData.Construct(), TimeOfCreation: 0, HitPlayer: null, DEBUG_ECCheck: null};  
    public static ProjData Construct(): {ProjState: ProjState.NULL, ReadOnly: ReadOnlyProjData.Construct(), TimeOfCreation: 0, HitPlayer: null};  
    //public static void AddArgs(in ProjectileArgs args) {projData.Map(v => projData[CurrentArrayIndex()].ProjArgs).ModAppend(args);}
}
