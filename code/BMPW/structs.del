}




globalvar OneTimeCheck[] _OTCQueue = [];
single struct OneTimeCheck
{
    public Number ID;
    public Vector StartPosition;
    public Number ChecksLeft;
    public Number Index;
    //Is State Check
    public Boolean IsSC: this.ChecksLeft == 3;
    //Is Player Collision
    public Boolean IsPC: this.ChecksLeft == 2;
    //Is Environment Collision
    public Boolean IsEC: this.ChecksLeft == 1;

    public static void Queue(in Number ID, in Vector StartPosition) {
        _OTCQueue.ModAppend(<OneTimeCheck>{
            ID: ID,
            StartPosition: StartPosition,
            ChecksLeft: 3,
            Index: _OTCQueue.Length
        });
    }

    public static void SpecialQueue(in OneTimeCheck data) {
        _OTCQueue.ModAppend(data);
    }

    public static void Truncate() {
        _OTCQueue = _OTCQueue.Filter(v => !v.ChecksLeft);
    }

    public static void TruncateByID(in Number ID) {
        _OTCQueue = _OTCQueue.Filter(v => v.ID != ID);
    }
}

